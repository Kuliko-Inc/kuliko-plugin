  "constraints": {
    "app/mcp/tools/exercises.py": {
      "_nonblank": "def _nonblank(value: str) -> str:\n    if not value.strip():\n        raise ValueError('A nonblank value is required')\n    return value",
      "_objective": "def _objective(value: str) -> str:\n    _nonblank(value)\n    if len(value.encode('utf-8')) > 2000:\n        raise ValueError('Each objective must be at most 2000 UTF-8 bytes')\n    return value",
      "_sources": "def _sources(value: list[str]) -> list[str]:\n    if len(set(value)) > 10:\n        raise ValueError('Select at most 10 unique documents; no documents were dropped')\n    return value",
      "Nonblank": "Nonblank = Annotated[str, AfterValidator(_nonblank), Field(min_length=1)]",
      "Objective": "Objective = Annotated[str, AfterValidator(_objective), Field(min_length=1, max_length=2000)]",
      "SourceSelection": "SourceSelection = Annotated[list[Nonblank], AfterValidator(_sources), Field(min_length=1, description='Explicitly selected owned documents in the subject or its folders. Maximum 10 unique documents and 160000 aggregate source UTF-8 bytes (validated by API). Never silently select or drop documents. Duplicates/reordering preserve the backend generation identity.')]",
      "Version": "Version = Annotated[int, Field(ge=1)]",
      "DraftVersion": "DraftVersion = Annotated[int, Field(ge=0)]",
      "Limit": "Limit = Annotated[int, Field(ge=1, le=100)]",
      "Offset": "Offset = Annotated[int, Field(ge=0)]"
    },
    "app/mcp/exercise_types.py": {
      "ExerciseMode": "ExerciseMode = Literal['apply', 'analyse']",
      "ExerciseDifficulty": "ExerciseDifficulty = Literal['introductory', 'intermediate', 'advanced']",
      "AssessmentState": "AssessmentState = Literal['pending', 'processing', 'complete', 'unavailable']",
      "CriterionStatus": "CriterionStatus = Literal['not_yet_demonstrated', 'partly_demonstrated', 'demonstrated']",
      "RevealKind": "RevealKind = Literal['hint', 'worked_answer']",
      "ExerciseEvidenceLinkState": "ExerciseEvidenceLinkState = Literal['current', 'historical']"
    },
    "app/mcp/tool_types.py": {
      "LearningResourceLanguage": "LearningResourceLanguage = Literal['english', 'french', 'spanish', 'german', 'italian', 'portuguese', 'dutch', 'polish', 'chinese', 'japanese', 'korean', 'arabic', 'hindi', 'russian', 'ukrainian', 'turkish', 'indonesian', 'vietnamese']"
    }
